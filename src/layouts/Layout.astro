---
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import navLinks from '../config/navLinks';
import socialLinks from '../config/socialLinks';
import footerLinks from '../config/footerLinks';
import '../styles/global.css';

interface Props {
  title?: string;
}

const { title = 'WWS - Soluciones Digitales' } = Astro.props;

// Declaración de tipos para Vercel Analytics
declare global {
  interface Window {
    va: any;
    vaq: any[];
  }
}
---

<!doctype html>
<html lang="es">
  <head>
    <!-- Google Tag Manager -->
      <script is:inline>
        (function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
        new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
        j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
        'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
        })(window,document,'script','dataLayer','GTM-PNCQ4NQR');
      </script>
    <meta charset="UTF-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no"
    />
    <!-- Favicon para mejor detección en Google -->
    <link rel="icon" type="image/svg+xml" href="/icons/favicon.svg" />
    <title>{title}</title>
    <meta name="description" content="WWS - Soluciones digitales innovadoras para tu negocio" />
  </head>
  <body>
    <!-- Google Tag Manager (noscript) -->
    <noscript><iframe src="https://www.googletagmanager.com/ns.html?id=GTM-PNCQ4NQR"
    height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>
    <!-- End Google Tag Manager (noscript) -->
    <Navbar links={navLinks} />
    <main>
      <slot />
    </main>
    <Footer socialLinks={socialLinks} footerLinks={footerLinks} />
  </body>
</html>

<style is:global>
  main {
    min-height: calc(100vh - 200px);
  }
</style>

