---
import Layout from '../../layouts/Layout.astro';
import { getProductos } from '../../lib/getProductos';
import { getAliados } from '../../lib/getAliados';
import ProductHero from '../../components/ProductHero.astro';
import ProductDescription from '../../components/ProductDescription.astro';
import ProductSubProducts from '../../components/ProductSubProducts.astro';
import Product3DViewer from '../../components/Product3DViewer.astro';
import ProductQR from '../../components/ProductQR.astro';
import ProductRelated from '../../components/ProductRelated.astro';
import ProductContact from '../../components/ProductContact.astro';

export async function getStaticPaths() {
  const productos = await getProductos();
  return productos.map(producto => ({
    params: { slug: producto.slug }
  }));
}

// Obtiene el slug de la URL y busca el producto correspondiente
const { slug } = Astro.params;
const productos = await getProductos();
const producto = productos.find(p => p.slug === slug);
const notFound = !producto;

  // Ruta del brochure en cPanel (assets/Productos/)
  const brochureUrl = "/assets/Portafolio/0) Brochure/BROCHURE WWS.pdf";
  
  // Obtener aliados y buscar si el producto tiene un aliado asociado
  const aliados = await getAliados();
  // Priorizar aliadoId sobre marca (para compatibilidad con datos antiguos)
  const aliadoProducto = producto?.aliadoId
    ? aliados.find(aliado => aliado.id === producto.aliadoId)
    : producto?.marca
      ? aliados.find(aliado => aliado.nombre.toLowerCase() === producto.marca!.toLowerCase())
      : null;

// Filtra productos relacionados por categoría, excluyendo el actual
const relacionados = producto
  ? productos.filter(p => p.categoria === producto.categoria && p.slug !== slug)
  : [];

// Verifica si el producto tiene subdivisiones
const tieneSubProductos = producto && producto.subProductos && producto.subProductos.length > 0;
---

<Layout title={notFound ? 'Producto no encontrado' : producto.nombre + ' - WWS'}>
  {notFound ? (
    <!-- Sección de error si el producto no existe -->
    <section class="min-h-[60vh] flex flex-col items-center justify-center">
      <h1 class="text-3xl font-bold text-red-600 mb-4">Producto no encontrado</h1>
      <a href="/productos" class="text-blue-600 underline">Volver a productos</a>
    </section>
  ) : (
    <main class="w-full bg-[#f5f5f5]">
      <ProductHero titulo={producto.nombre} imagen={producto.imagen} />
      <ProductDescription 
        nombre={producto.nombre} 
        descripcionLarga={producto.descripcionLarga} 
        imagen={producto.imagen} 
        brochureUrl={brochureUrl} 
        catalogoUrl={producto.pdf}
        aliadoLogo={aliadoProducto?.logo}
        aliadoUrl={aliadoProducto?.url}
        aliadoNombre={aliadoProducto?.nombre}
      />

      {tieneSubProductos ? (
        <ProductSubProducts subProductos={producto.subProductos!} productSlug={producto.slug} />
      ) : (
        <!-- PRODUCTO SIMPLE: Muestra el modelo 3D y partes directamente -->
        <>
          {(Array.isArray(producto.marcadores3d) && producto.marcadores3d.length > 0 && producto.modelo3d) && (
            <Product3DViewer modelo3d={producto.modelo3d} marcadores3d={producto.marcadores3d} />
          )}
          {producto.qr && (
            <ProductQR qrUrl={producto.qr} />
          )}
        </>
      )}

      {relacionados.length > 0 && (
        <ProductRelated productos={relacionados} />
      )}

      <ProductContact 
        titulo="Cuéntanos más sobre ti y tu proyecto"
        descripcion="Para ofrecerte un acompañamiento más personalizado y eficiente, necesitamos conocer algunos detalles sobre ti y tus objetivos. Llena el siguiente formulario y nuestro equipo se pondrá en contacto contigo con una propuesta ajustada a tus necesidades."
        botonTexto="LLENA AQUÍ"
        botonUrl={producto.formUrl}
      />
    </main>
  )}

</Layout> 