---
import Layout from '../../layouts/Layout.astro';
import { productos } from '../../data/productos';

const { slug } = Astro.params;
const producto = productos.find(p => p.slug === slug);
const notFound = !producto;

// Brochure general (puedes ponerlo en config si lo prefieres)
const brochureUrl = "https://drive.google.com/your-brochure-link";
// Formulario de Google
const formUrl = "https://forms.gle/your-form-link";

// Productos relacionados (misma categoría, excluyendo el actual)
const relacionados = producto
  ? productos.filter(p => p.categoria === producto.categoria && p.slug !== slug)
  : [];
---

<Layout title={notFound ? 'Producto no encontrado' : producto.nombre + ' - WWS'}>
  {notFound ? (
    <section class="min-h-[60vh] flex flex-col items-center justify-center">
      <h1 class="text-3xl font-bold text-red-600 mb-4">Producto no encontrado</h1>
      <a href="/productos" class="text-blue-600 underline">Volver a productos</a>
    </section>
  ) : (
    <main class="w-full bg-[#f5f5f5]">
      {/* HERO */}
      <section class="relative w-full h-64 md:h-80 flex items-end justify-start bg-cover bg-center z-0" style={`background-image: url('${producto.imagen}')`}>
        <div class="absolute inset-0 bg-black/40"></div>
        <div class="relative z-10 p-8">
          <h1 class="text-3xl md:text-5xl font-extrabold text-white drop-shadow-lg">{producto.nombre}</h1>
        </div>
      </section>

      {/* DESCRIPCIÓN AMPLIADA Y BROCHURE */}
      <section class="max-w-5xl mx-auto grid grid-cols-1 md:grid-cols-3 gap-6 mt-8 items-start">
        <div class="md:col-span-2 flex flex-col justify-center">
          <h2 class="text-2xl md:text-3xl font-extrabold text-[#20405C] mb-2 uppercase tracking-tight" style="letter-spacing:0;">{producto.categoria}</h2>
          <p class="text-black text-justify mb-4" style="hyphens:auto;">{producto.descripcion}</p>
          <a href={brochureUrl} target="_blank" rel="noopener" class="text-[#20405C] underline font-medium mb-2 w-fit">Descarga nuestro catálogo</a>
          <a href={brochureUrl} target="_blank" rel="noopener" class="mt-1 w-fit px-6 py-2 rounded font-bold shadow bg-[#7A8C8C] text-white text-lg hover:bg-[#5a6c6c] transition block" style="box-shadow:0 2px 6px 0 rgba(0,0,0,0.10);">BROCHURE</a>
        </div>
        <div class="flex items-center justify-center">
          <img src={producto.imagen} alt={producto.nombre} class="rounded-lg max-h-56 object-cover border border-[#bfc9c9]" style="box-shadow:0 2px 8px 0 rgba(0,0,0,0.10);" loading="lazy" />
        </div>
      </section>

      {/* PARTES Y MODELO 3D */}
      {(Array.isArray(producto.accesorios) && producto.accesorios.length > 0 || producto.modelo3d) && (
        <section class="max-w-6xl mx-auto grid grid-cols-1 md:grid-cols-3 gap-6 bg-[#eaeaea] rounded-lg shadow-lg mt-8 p-6">
          {/* PARTES */}
          <div>
            <h3 class="text-lg font-bold text-white bg-[#6B8C8C] rounded-t px-4 py-2 mb-2">PARTES</h3>
            <ul class="bg-white rounded-b p-2">
              {producto.accesorios?.map((parte, idx) => (
                <li class="border-b last:border-b-0 py-1 text-[#355353] font-semibold text-sm">
                  • {parte.nombre}
                </li>
              ))}
            </ul>
          </div>
          {/* MODELO 3D */}
          <div class="md:col-span-2 flex items-center justify-center">
            {producto.modelo3d ? (
              <>
                <model-viewer
                  src={producto.modelo3d}
                  camera-controls
                  ar
                  auto-rotate
                  style="width: 100%; max-width: 500px; height: 320px; background: #fff; border-radius: 1rem;"
                  exposure="1"
                >
                  {producto.marcadores3d && producto.marcadores3d.map((m, i) => (
                    <button
                      slot={`hotspot-${i}`}
                      data-position={`${m.x} ${m.y} ${m.z}`}
                      data-normal="0 1 0"
                      class="bg-[#4F6E6E] text-white rounded px-2 py-1 text-xs font-bold"
                      style="pointer-events: auto;"
                    >{m.label}</button>
                  ))}
                </model-viewer>
                <script type="module" src="https://unpkg.com/@google/model-viewer/dist/model-viewer.min.js"></script>
              </>
            ) : (
              <div class="text-gray-500 italic">No hay modelo 3D disponible</div>
            )}
          </div>
        </section>
      )}

      {/* QR */}
      <section class="max-w-6xl mx-auto flex flex-col md:flex-row items-center justify-center gap-6 bg-[#eaeaea] rounded-lg shadow-lg mt-8 p-6">
        <img src={`/assets/qr/${producto.slug}.png`} alt="Código QR" class="w-32 h-32 object-contain bg-white rounded shadow" />
        <div>
          <h3 class="text-2xl font-bold text-[#355353] mb-2">ESCANEA EL CÓDIGO</h3>
        </div>
      </section>

      {/* PRODUCTOS RELACIONADOS */}
      {relacionados.length > 0 && (
        <section class="max-w-6xl mx-auto py-12">
          <h2 class="text-2xl md:text-3xl font-extrabold text-center mb-8">Productos relacionados</h2>
          <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 gap-4">
            {relacionados.map(prod => (
              <a href={`/productos/${prod.slug}`} class="group block rounded-lg overflow-hidden shadow-lg transition-transform duration-300 hover:scale-105 hover:shadow-2xl bg-white">
                <div class="relative w-full aspect-[1/1] min-h-[120px] overflow-hidden">
                  <img src={prod.imagen} alt={prod.nombre} class="w-full h-full object-cover" loading="lazy" />
                </div>
                <div class="p-2 text-center font-bold text-[#355353] group-hover:text-[#12726C] uppercase">{prod.nombre}</div>
              </a>
            ))}
          </div>
        </section>
      )}

      {/* CUÉNTANOS MÁS SOBRE TI Y TU PROYECTO */}
      <section class="max-w-6xl mx-auto grid grid-cols-1 md:grid-cols-3 gap-6 bg-[#d3dbdb] rounded-lg shadow-lg mt-8 p-6 items-center">
        <div class="md:col-span-2">
          <h2 class="text-2xl md:text-3xl font-extrabold mb-2">Cuéntanos más sobre ti y tu proyecto</h2>
          <p class="mb-4 text-gray-700">
            Para ofrecerte un acompañamiento más personalizado y eficiente, necesitamos conocer algunos detalles sobre ti y tus objetivos. Llena el siguiente formulario y nuestro equipo se pondrá en contacto contigo con una propuesta ajustada a tus necesidades.
          </p>
          <a href={formUrl} target="_blank" rel="noopener" class="inline-block bg-[#6B8C8C] text-white px-6 py-3 rounded font-bold shadow hover:bg-[#355353] transition">
            LLENA AQUÍ
          </a>
        </div>
        <div class="flex items-center justify-center">
          <img src="/assets/imagen-formulario.jpg" alt="Imagen proyecto" class="rounded-lg shadow max-h-48 object-cover" loading="lazy" />
        </div>
      </section>
    </main>
  )}
</Layout> 