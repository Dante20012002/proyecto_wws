---
import Layout from '../../layouts/Layout.astro';
import { productos } from '../../data/productos';
import ModelViewer from '../../components/ModelViewer.jsx';

// Obtiene el slug de la URL y busca el producto correspondiente
const { slug } = Astro.params;
const producto = productos.find(p => p.slug === slug);
const notFound = !producto;

// URL del brochure general y formulario de contacto
const brochureUrl = "https://drive.google.com/your-brochure-link";
const formUrl = "https://forms.gle/your-form-link";

// Filtra productos relacionados por categoría, excluyendo el actual
const relacionados = producto
  ? productos.filter(p => p.categoria === producto.categoria && p.slug !== slug)
  : [];
---

<Layout title={notFound ? 'Producto no encontrado' : producto.nombre + ' - WWS'}>
  {notFound ? (
    <!-- Sección de error si el producto no existe -->
    <section class="min-h-[60vh] flex flex-col items-center justify-center">
      <h1 class="text-3xl font-bold text-red-600 mb-4">Producto no encontrado</h1>
      <a href="/productos" class="text-blue-600 underline">Volver a productos</a>
    </section>
  ) : (
    <main class="w-full bg-[#f5f5f5]">
      <!-- HERO: Imagen de fondo y título principal de la página de producto -->
      <section class="relative w-full h-[220px] md:h-[320px] flex items-end justify-start bg-cover bg-center z-0" style={`background-image: url('${producto.imagen}');`}>
        <div class="absolute inset-0 bg-black/50"></div>
        <div class="relative z-10 p-6 md:p-12">
          <h1 class="text-3xl md:text-5xl font-extrabold text-white drop-shadow-xl leading-tight md:leading-tight uppercase" style="text-shadow: 2px 2px 8px #000;">
            {producto.nombre}
          </h1>
        </div>
      </section>

      <!-- DESCRIPCIÓN AMPLIADA Y BROCHURE: Información principal del producto, descripción y enlaces de descarga -->
      <section class="w-full bg-white py-8">
        <div class="max-w-2xl md:max-w-5xl mx-auto grid grid-cols-1 md:grid-cols-3 gap-8 items-start px-4 md:px-8">
          <div class="md:col-span-2 flex flex-col justify-center">
            <h2 class="text-2xl md:text-3xl font-extrabold text-[#20405C] mb-2 uppercase tracking-tight" style="letter-spacing:0;">{producto.nombre}</h2>
            <p class="text-black text-justify mb-4 text-base md:text-lg leading-relaxed" style="hyphens:auto;">{producto.descripcionLarga}</p>
            <a href={brochureUrl} target="_blank" rel="noopener" class="text-[#20405C] underline font-medium mb-2 w-fit">Descarga nuestro catálogo</a>
            <a href={brochureUrl} target="_blank" rel="noopener" class="mt-1 w-fit px-8 py-2 rounded font-bold shadow bg-[#7A8C8C] text-white text-lg hover:bg-[#5a6c6c] transition block" style="box-shadow:0 2px 6px 0 rgba(0,0,0,0.10);">BROCHURE</a>
          </div>
          <div class="flex items-center justify-center">
            <img src={producto.imagen} alt={producto.nombre} class="rounded-lg max-h-56 md:max-h-64 aspect-square object-cover border-4 border-[#bfc9c9] shadow-lg" style="box-shadow:0 2px 8px 0 rgba(0,0,0,0.10);" loading="lazy" />
          </div>
        </div>
      </section>

      <!-- PARTES Y MODELO 3D: Lista de partes (marcadores3d) y visor interactivo del modelo 3D
           - La lista de partes se numera y se alinea con los hotspots del modelo 3D
           - El modelo 3D es responsivo y está envuelto en un fondo blanco con sombra
           - Al hacer clic en una parte de la lista, se hace zoom al hotspot correspondiente -->
      {(Array.isArray(producto.marcadores3d) && producto.marcadores3d.length > 0 && producto.modelo3d) && (
        <section class="w-full bg-[#eaeaea] py-8">
          <div class="max-w-4xl mx-auto flex flex-col md:flex-row items-center justify-center gap-6 md:gap-14 px-2 md:px-4">
            <!-- Lista de partes numeradas -->
            <div class="w-full md:max-w-xs flex flex-col mb-6 md:mb-0">
              <h3 class="text-lg font-bold text-white bg-[#6B8C8C] rounded-t-md px-4 py-2 mb-0">PARTES</h3>
              <ul class="bg-[#6B8C8C] rounded-b-md p-0 divide-y divide-[#eaeaea] flex-1" id="partes-lista">
                {producto.marcadores3d.map((marcador, idx) => (
                  <li 
                    class="flex items-center gap-2 py-2 px-4 text-white font-semibold text-sm cursor-pointer hover:bg-[#355353] transition hover:scale-105 transform duration-200" 
                    data-hotspot={idx}
                    data-part-index={idx}
                  >
                    <span class="inline-flex items-center justify-center w-6 h-6 rounded-full bg-[#20405C] text-white font-bold mr-2">{idx + 1}</span>
                    {marcador.label && marcador.label[0]?.nombre}
                  </li>
                ))}
              </ul>
            </div>
            <!-- Visor del modelo 3D con hotspots numerados -->
            <div class="flex-1 flex items-center justify-center w-full">
              <div class="w-full bg-white rounded-xl shadow-lg flex items-center justify-center p-2 md:p-6" style="max-width: 100%;">
                <!-- ModelViewer: componente React que renderiza el modelo 3D y los hotspots
                     - Props: src (ruta del modelo), marcadores3d (array de partes), showNumbers (muestra números en los hotspots)
                     - style: controla el tamaño responsivo del visor -->
                <ModelViewer 
                  src={producto.modelo3d} 
                  marcadores3d={producto.marcadores3d} 
                  client:only="react" 
                  showNumbers 
                  style={{ width: '100%', maxWidth: 500, minHeight: 220, maxHeight: 400, background: '#fff', borderRadius: '1rem' }} 
                />
              </div>
            </div>
          </div>
        </section>
      )}

      <!-- QR: Sección con código QR para el producto, responsiva y compacta -->
      <section class="w-full bg-[#eaeaea] py-8">
        <div class="max-w-md mx-auto flex flex-row items-center gap-0 px-4">
          <div class="bg-white rounded-l-lg rounded-r-none flex items-center justify-center p-4 shadow-md" style="width: 100px; min-width: 100px; height: 90px;">
            <img src={`/assets/qr/${producto.slug}.png`} alt="Código QR" class="w-16 h-16 object-contain" />
          </div>
          <div class="flex-1 flex items-center h-[90px]">
            <div class="w-full h-full flex items-center justify-center bg-[#6B8C8C] rounded-r-lg rounded-l-none">
              <h3 class="text-lg md:text-2xl font-extrabold text-white px-4 py-2 uppercase text-center w-full">ESCANEA EL CÓDIGO</h3>
            </div>
          </div>
        </div>
      </section>

      <!-- PRODUCTOS RELACIONADOS: Tarjetas de productos con overlay, centradas y responsivas
           - Usa flex-wrap y justify-center para centrar las tarjetas
           - Tarjetas con hover, blur y descripción -->
      {relacionados.length > 0 && (
        <section class="max-w-6xl mx-auto py-12 pb-24">
          <h2 class="text-2xl md:text-3xl font-extrabold text-center mb-8">Productos relacionados</h2>
          <div class="w-full flex justify-center">
            <div class="flex flex-wrap justify-center gap-4 w-full">
              {relacionados.map(prod => (
                <a href={`/productos/${prod.slug}`} class="group block rounded-lg overflow-hidden shadow-lg transition-transform duration-300 hover:scale-105 hover:shadow-2xl relative bg-transparent max-w-xs w-full sm:w-[220px] md:w-[240px]">
                  <div class="relative w-full aspect-[9/4] sm:aspect-[9/3] min-h-[160px] sm:min-h-[220px] md:min-h-[220px] md:aspect-[6/3] overflow-hidden">
                    <img src={prod.imagen} alt={prod.nombre} class="w-full h-full object-cover" loading="lazy" />
                    <div class="absolute inset-0 flex flex-col items-center justify-center opacity-0 group-hover:opacity-100 transition-opacity duration-300 backdrop-blur-md bg-black/40 px-4 py-4 overflow-y-auto max-h-full">
                      <h2 class="text-white text-lg md:text-xl font-bold text-center drop-shadow-lg mb-2">{prod.nombre}</h2>
                      <p class="text-white text-center text-sm md:text-base break-words">{prod.descripcion}</p>
                    </div>
                    <div class="absolute top-0 left-0 w-full px-2 py-2 flex items-center justify-center group-hover:opacity-0 transition-opacity duration-300">
                      <h2 class="text-white text-base md:text-lg font-bold text-center w-full drop-shadow-lg">{prod.nombre}</h2>
                    </div>
                  </div>
                </a>
              ))}
            </div>
          </div>
        </section>
      )}

      <!-- CUÉNTANOS MÁS SOBRE TI Y TU PROYECTO: Sección de contacto con imagen sobresaliente y sombra
           - La imagen sobresale hacia arriba y tiene sombra
           - El layout es responsivo y la imagen se mantiene centrada -->
      <section class="w-full bg-[#eaeaea] py-8">
        <div class="max-w-6xl mx-auto grid grid-cols-1 md:grid-cols-3 gap-8 rounded-lg items-center px-4 md:px-8 relative">
          <div class="md:col-span-2 z-10">
            <h2 class="text-2xl md:text-3xl font-extrabold mb-2">Cuéntanos más sobre ti y tu proyecto</h2>
            <p class="mb-4 text-gray-700 text-base md:text-lg">
              Para ofrecerte un acompañamiento más personalizado y eficiente, necesitamos conocer algunos detalles sobre ti y tus objetivos. Llena el siguiente formulario y nuestro equipo se pondrá en contacto contigo con una propuesta ajustada a tus necesidades.
            </p>
            <a href={formUrl} target="_blank" rel="noopener" class="inline-block bg-[#6B8C8C] text-white px-8 py-3 rounded font-bold shadow hover:bg-[#355353] transition text-lg">
              LLENA AQUÍ
            </a>
          </div>
          <div class="flex items-center justify-center relative h-full">
            <img src="/assets/Imagen formulario.jpg" alt="Imagen proyecto" class="rounded-lg shadow-2xl max-h-64 aspect-square object-cover relative z-20" style="top: -60px; box-shadow: 0 12px 40px 0 rgba(0,0,0,0.28);" />
            <div class="absolute left-1/2 -translate-x-1/2 top-0 w-full h-full z-10 pointer-events-none"></div>
          </div>
        </div>
      </section>
    </main>
  )}

  <!-- Script para manejar la interacción entre la lista de partes y el modelo 3D -->
  {(Array.isArray(producto?.marcadores3d) && producto.marcadores3d.length > 0 && producto.modelo3d) && (
    <script define:vars={{ marcadores3d: producto.marcadores3d }}>
      document.addEventListener('DOMContentLoaded', function() {
        const partesLista = document.getElementById('partes-lista');
        if (!partesLista) return;

        // Esperar a que el componente React se renderice
        setTimeout(() => {
          const modelViewer = document.querySelector('model-viewer');
          if (!modelViewer) return;

          // Agregar event listeners a cada parte de la lista
          const partesItems = partesLista.querySelectorAll('li[data-part-index]');
          partesItems.forEach(item => {
            item.addEventListener('click', function() {
              const partIndex = parseInt(this.getAttribute('data-part-index'));
              
              // Remover clase activa de todos los items
              partesItems.forEach(li => li.classList.remove('bg-[#355353]'));
              
              // Agregar clase activa al item clickeado
              this.classList.add('bg-[#355353]');
              
              // Hacer zoom al hotspot correspondiente
              if (modelViewer && modelViewer.cameraTarget && marcadores3d && marcadores3d[partIndex]) {
                const hotspot = marcadores3d[partIndex];
                const position = `${hotspot.x}m ${hotspot.y}m ${hotspot.z}m`;
                
                // Animar la cámara hacia el hotspot
                modelViewer.cameraOrbit = `0deg 75deg 2.5m`;
                modelViewer.cameraTarget = position;
                
                // Zoom más cercano al hotspot
                setTimeout(() => {
                  modelViewer.cameraOrbit = `0deg 75deg 1.5m`;
                  modelViewer.cameraTarget = position;
                }, 500);
              }
            });
          });
        }, 1000); // Esperar 1 segundo para que el componente React se renderice completamente
      });
    </script>
  )}
</Layout> 