---
import Layout from '../../../layouts/Layout.astro';
import { productos } from '../../../data/productos';
import ProductHero from '../../../components/ProductHero.astro';
import ProductDescription from '../../../components/ProductDescription.astro';
import Product3DViewer from '../../../components/Product3DViewer.astro';
import ProductQR from '../../../components/ProductQR.astro';
import ProductRelated from '../../../components/ProductRelated.astro';
import ProductContact from '../../../components/ProductContact.astro';

export async function getStaticPaths() {
  const paths = [];
  
  for (const producto of productos) {
    if (producto.subProductos && producto.subProductos.length > 0) {
      for (const subProducto of producto.subProductos) {
        paths.push({
          params: { 
            producto: producto.slug, 
            subproducto: subProducto.slug 
          }
        });
      }
    }
  }
  
  return paths;
}

// Obtiene los parámetros de la URL
const { producto: productSlug, subproducto: subProductSlug } = Astro.params;

// Busca el producto principal
const producto = productos.find(p => p.slug === productSlug);

// Busca el subproducto específico
const subProducto = producto?.subProductos?.find(sp => sp.slug === subProductSlug);

const notFound = !producto || !subProducto;

// URL del brochure general
const brochureUrl = "https://drive.google.com/uc?export=download&id=1Cxu1Nftv6efl52-7mPSrBA_OSv52uKDO";

// Filtra productos relacionados por categoría, excluyendo el actual
const relacionados = producto
  ? productos.filter(p => p.categoria === producto.categoria && p.slug !== productSlug)
  : [];
---

<Layout title={notFound ? 'Producto no encontrado' : subProducto.nombre + ' - WWS'}>
  {notFound ? (
    <!-- Sección de error si el producto o subproducto no existe -->
    <section class="min-h-[60vh] flex flex-col items-center justify-center">
      <h1 class="text-3xl font-bold text-red-600 mb-4">Producto no encontrado</h1>
      <a href="/productos" class="text-blue-600 underline">Volver a productos</a>
    </section>
  ) : (
    <main class="w-full bg-[#f5f5f5]">
      <ProductHero 
        titulo={subProducto.nombre} 
        imagen={subProducto.imagen} 
        breadcrumb={{ texto: producto.nombre, url: `/productos/${producto.slug}` }}
      />
      <ProductDescription 
        nombre={subProducto.nombre} 
        descripcionLarga={subProducto.descripcionLarga} 
        imagen={subProducto.imagen} 
        brochureUrl={brochureUrl} 
        catalogoUrl={subProducto.pdf}
      />

      {(Array.isArray(subProducto.marcadores3d) && subProducto.marcadores3d.length > 0 && subProducto.modelo3d) && (
        <Product3DViewer modelo3d={subProducto.modelo3d} marcadores3d={subProducto.marcadores3d} />
      )}

      {subProducto.qr && (
        <ProductQR qrUrl={subProducto.qr} />
      )}

      {relacionados.length > 0 && (
        <ProductRelated productos={relacionados} />
      )}

      {subProducto.formUrl ? (
        <ProductContact 
          titulo="Cotiza este producto"
          descripcion={`¿Te interesa ${subProducto.nombre}? Llena el formulario de cotización específico para este producto y nuestro equipo te contactará con una propuesta personalizada.`}
          botonTexto="COTIZAR AHORA"
          botonUrl={subProducto.formUrl}
        />
      ) : (
        <ProductContact 
          titulo="Cuéntanos más sobre ti y tu proyecto"
          descripcion="Para ofrecerte un acompañamiento más personalizado y eficiente, necesitamos conocer algunos detalles sobre ti y tus objetivos. Llena el siguiente formulario y nuestro equipo se pondrá en contacto contigo con una propuesta ajustada a tus necesidades."
          botonTexto="LLENA AQUÍ"
          botonUrl="https://forms.gle/your-form-link"
        />
      )}
    </main>
  )}

</Layout> 