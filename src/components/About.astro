---
import { getEmpresaInfo } from '../lib/getEmpresa';

const empresaInfo = await getEmpresaInfo();
const sobreNosotros = empresaInfo?.sobreNosotros || {
  titulo: 'WATER WISE SERVICES',
  texto: 'Nos especializamos en la comercialización, instalación y mantenimiento de equipos para el tratamiento de agua. Ofrecemos soluciones integrales con respaldo técnico, eficiencia y compromiso, aportando a la gestión responsable del agua en Colombia y Sudamérica.',
  imagen: '/assets/Agua.jpg'
};
---

<section class="w-full bg-white py-8 md:py-12">
  <div class="max-w-6xl mx-auto px-4 flex flex-col md:flex-row items-center gap-6 md:gap-8">
    <div class="flex-1 w-full md:w-auto flex justify-center fade-section opacity-0 translate-y-8 transition-all duration-700 will-change-transform">
      <img
        src={sobreNosotros.imagen || '/assets/Agua.jpg'}
        alt="Agua"
        class="rounded-lg shadow-lg w-full md:w-auto max-h-[200px] sm:max-h-[250px] md:max-h-[300px] object-cover"
        loading="lazy" decoding="async" fetchpriority="low"
        width="300" height="300"
      />
    </div>
    <div class="flex-1 text-center md:text-left fade-section opacity-0 translate-y-8 transition-all duration-700 will-change-transform">
      <h2 class="text-[#4F6E6E] text-xl sm:text-2xl md:text-3xl font-bold mb-2 md:mb-3 break-words">{sobreNosotros.titulo}</h2>
      <div class="text-gray-700 text-sm sm:text-base md:text-lg text-balance break-words" set:html={sobreNosotros.texto} />
    </div>
  </div>
</section>

<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    const observer = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          entry.target.classList.add('animate-fade-in');
          observer.unobserve(entry.target);
        }
      });
    }, { threshold: 0.15 });
    document.querySelectorAll('.fade-section').forEach(el => observer.observe(el));
  });
</script>
<style is:global>
@keyframes fade-in {
  from { opacity: 0; transform: translateY(32px);}
  to { opacity: 1; transform: translateY(0);}
}
.animate-fade-in {
  opacity: 1 !important;
  transform: none !important;
  animation: fade-in 0.8s cubic-bezier(0.4,0,0.2,1) both;
}
</style>

