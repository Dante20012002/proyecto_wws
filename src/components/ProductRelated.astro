---
import type { Producto } from '../data/productos';

export interface Props {
  productos: Producto[];
}

const { productos } = Astro.props;
---

<!-- PRODUCTOS RELACIONADOS: Tarjetas de productos con overlay, centradas y responsivas
     - Usa flex-wrap y justify-center para centrar las tarjetas
     - Tarjetas con hover, blur y descripción -->
<section class="max-w-6xl mx-auto py-12 pb-24">
  <h2 class="text-2xl md:text-3xl font-extrabold text-center mb-8 text-[#577979]">Productos relacionados</h2>
  <div class="w-full flex justify-center">
    <div class="flex flex-wrap justify-center gap-4 w-full">
      {productos.map(prod => (
        <a href={`/productos/${prod.slug}`} class="group block rounded-lg overflow-hidden shadow-lg transition-transform duration-300 hover:scale-105 hover:shadow-2xl relative bg-transparent max-w-xs w-full sm:w-[220px] md:w-[240px]">
          <div class="relative w-full aspect-[9/4] sm:aspect-[9/3] min-h-[160px] sm:min-h-[220px] md:min-h-[220px] md:aspect-[6/3] overflow-hidden">
            <img src={prod.imagen} alt={prod.nombre} class="w-full h-full object-cover" loading="lazy" />
            <div class="absolute inset-0 flex flex-col items-center justify-center opacity-0 group-hover:opacity-100 transition-opacity duration-300 backdrop-blur-md bg-black/40 overflow-y-auto py-4 px-2 sm:px-3 md:px-4">
              <h2 class="text-white text-sm sm:text-base md:text-lg lg:text-xl font-bold text-center drop-shadow-lg mb-2">{prod.nombre}</h2>
              <p class="text-white text-center text-xs sm:text-sm md:text-base break-words">{prod.descripcion}</p>
            </div>
            <div class="absolute top-0 left-0 w-full px-2 py-2 flex items-center justify-center group-hover:opacity-0 transition-opacity duration-300">
              <h2 class="text-[#6B8C8C] text-sm sm:text-base md:text-lg lg:text-xl font-bold text-center w-full drop-shadow-[0_2px_4px_rgba(0,0,0,0.8)] bg-white/90 backdrop-blur-sm rounded-md px-2 py-1">{prod.nombre}</h2>
            </div>
          </div>
        </a>
      ))}
    </div>
  </div>
</section>

<style is:global>
/* Personalizar barra de scroll - estilo estético para productos relacionados */
.group:hover .overflow-y-auto {
  scrollbar-width: thin; /* Firefox - barra delgada */
  scrollbar-color: rgba(255, 255, 255, 0.5) transparent; /* Firefox - thumb y track */
}

/* Chrome, Safari y Opera */
.group:hover .overflow-y-auto::-webkit-scrollbar {
  width: 6px; /* Ancho de la barra */
}

.group:hover .overflow-y-auto::-webkit-scrollbar-track {
  background: transparent; /* Fondo transparente */
}

.group:hover .overflow-y-auto::-webkit-scrollbar-thumb {
  background: rgba(255, 255, 255, 0.4); /* Color del thumb semi-transparente */
  border-radius: 10px; /* Bordes redondeados */
  transition: background 0.3s ease;
}

.group:hover .overflow-y-auto::-webkit-scrollbar-thumb:hover {
  background: rgba(255, 255, 255, 0.7); /* Más visible al hacer hover en la barra */
}

.group:hover .overflow-y-auto::-webkit-scrollbar-thumb:active {
  background: rgba(255, 255, 255, 0.9); /* Aún más visible al hacer clic */
}
</style> 