---
export interface Props {
  titulo: string;
  descripcion: string;
  botonTexto: string;
  botonUrl: string;
}

const { titulo, descripcion, botonTexto, botonUrl } = Astro.props;
---

<!-- CUÉNTANOS MÁS SOBRE TI Y TU PROYECTO: Sección de contacto con imagen sobresaliente y sombra
     - La imagen sobresale hacia arriba y tiene sombra solo en md+ -->
<section class="w-full bg-[#eaeaea] py-8">
  <div class="max-w-6xl mx-auto grid grid-cols-1 md:grid-cols-3 gap-8 rounded-lg items-center px-4 md:px-8 relative">
    <div class="md:col-span-2">
      <h2 class="text-2xl md:text-3xl font-extrabold mb-2">{titulo}</h2>
      <p class="mb-4 text-gray-700 text-base md:text-lg">
        {descripcion}
      </p>
      <a href={botonUrl} target="_blank" rel="noopener" class="inline-block bg-[#6B8C8C] text-white px-8 py-3 rounded font-bold shadow hover:bg-[#355353] transition text-lg">
        {botonTexto}
      </a>
    </div>
    <div class="flex items-center justify-center relative h-full order-last md:order-none mt-8 md:mt-0">
      <img 
        src="/assets/Imagen formulario.jpg" 
        alt="Imagen proyecto" 
        class="rounded-lg shadow-2xl max-h-64 aspect-square object-cover relative z-1 top-0 md:-top-16" 
        style="box-shadow: 0 12px 40px 0 rgba(0,0,0,0.28);" 
      />
      <div class="absolute left-1/2 -translate-x-1/2 top-0 w-full h-full z-10 pointer-events-none"></div>
    </div>
  </div>
</section> 