---
import type { SubProducto } from '../data/productos';
import { getAliados } from '../lib/getAliados';

export interface Props {
  subProductos: SubProducto[];
  productSlug: string;
}

const { subProductos, productSlug } = Astro.props;

// Obtener aliados desde Firestore
const aliados = await getAliados();

// Función helper para obtener el aliado por ID o nombre (compatibilidad)
function getAliadoForSubProducto(subProducto: SubProducto): typeof aliados[0] | undefined {
  // Priorizar aliadoId sobre marca (para compatibilidad con datos antiguos)
  if (subProducto.aliadoId) {
    return aliados.find(aliado => aliado.id === subProducto.aliadoId);
  }
  if (subProducto.marca) {
    return aliados.find(aliado => aliado.nombre.toLowerCase() === subProducto.marca?.toLowerCase());
  }
  return undefined;
}
---

<!-- PRODUCTO CON SUBDIVISIONES: Tarjetas tipo productos relacionados, pero más grandes -->
<section class="max-w-6xl mx-auto py-12 pb-24">
  <h2 class="text-2xl md:text-3xl font-extrabold text-center mb-8 text-[#4F6E6E]">Variantes Disponibles</h2>
  <div class="w-full flex justify-center">
    <div class="flex flex-wrap justify-center gap-6 w-full">
      {subProductos.map(subProducto => (
        <a href={`/productos/${productSlug}/${subProducto.slug}`} class="group block rounded-lg overflow-hidden shadow-lg transition-transform duration-300 hover:scale-105 hover:shadow-2xl relative bg-transparent max-w-sm w-full sm:w-[270px] md:w-[300px]">
          <div class="relative w-full aspect-[9/4] sm:aspect-[9/3] min-h-[220px] sm:min-h-[270px] md:min-h-[300px] md:aspect-[6/3] overflow-hidden">
            <img src={subProducto.imagen} alt={subProducto.nombre} class="w-full h-full object-cover" loading="lazy" />
            <div class="absolute inset-0 flex flex-col items-center justify-center opacity-0 group-hover:opacity-100 transition-opacity duration-300 backdrop-blur-md bg-black/40 overflow-y-auto py-4 px-2 sm:px-4 md:px-6">
              <h3 class="text-white text-sm sm:text-base md:text-lg lg:text-xl font-bold text-center drop-shadow-lg mb-2">{subProducto.nombre}</h3>
              <p class="text-white text-center text-xs sm:text-sm md:text-base break-words mb-4">{subProducto.descripcion}</p>
            </div>
            <div class="absolute top-0 left-0 w-full px-2 py-2 flex items-center justify-center group-hover:opacity-0 transition-opacity duration-300">
              <h3 class="text-[#6B8C8C] text-sm sm:text-base md:text-lg lg:text-xl font-bold text-center w-full drop-shadow-[0_2px_4px_rgba(0,0,0,0.8)] bg-white/90 backdrop-blur-sm rounded-md px-2 py-1">{subProducto.nombre}</h3>
            </div>
            {(() => {
              const aliado = getAliadoForSubProducto(subProducto);
              return aliado && aliado.logo ? (
                <div class="absolute bottom-2 right-2 bg-white p-1 rounded-md shadow-md">
                  <img src={aliado.logo} alt={`Logo ${aliado.nombre}`} class="h-6 object-contain" />
                </div>
              ) : null;
            })()}
          </div>
        </a>
      ))}
    </div>
  </div>
</section>

<style is:global>
/* Personalizar barra de scroll - estilo estético para subproductos */
.group:hover .overflow-y-auto {
  scrollbar-width: thin; /* Firefox - barra delgada */
  scrollbar-color: rgba(255, 255, 255, 0.5) transparent; /* Firefox - thumb y track */
}

/* Chrome, Safari y Opera */
.group:hover .overflow-y-auto::-webkit-scrollbar {
  width: 6px; /* Ancho de la barra */
}

.group:hover .overflow-y-auto::-webkit-scrollbar-track {
  background: transparent; /* Fondo transparente */
}

.group:hover .overflow-y-auto::-webkit-scrollbar-thumb {
  background: rgba(255, 255, 255, 0.4); /* Color del thumb semi-transparente */
  border-radius: 10px; /* Bordes redondeados */
  transition: background 0.3s ease;
}

.group:hover .overflow-y-auto::-webkit-scrollbar-thumb:hover {
  background: rgba(255, 255, 255, 0.7); /* Más visible al hacer hover en la barra */
}

.group:hover .overflow-y-auto::-webkit-scrollbar-thumb:active {
  background: rgba(255, 255, 255, 0.9); /* Aún más visible al hacer clic */
}
</style> 