---
import type { SubProducto } from '../data/productos';

export interface Props {
  subProductos: SubProducto[];
  productSlug: string;
}

const { subProductos, productSlug } = Astro.props;
---

<!-- PRODUCTO CON SUBDIVISIONES: Muestra las variantes del producto -->
<section class="w-full bg-[#eaeaea] py-8">
  <div class="max-w-6xl mx-auto px-4 md:px-8">
    <h2 class="text-2xl md:text-3xl font-extrabold text-center mb-8 text-[#20405C]">Variantes Disponibles</h2>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      {subProductos.map(subProducto => (
        <div class="bg-white rounded-xl shadow-lg overflow-hidden hover:shadow-xl transition-shadow duration-300 flex flex-col h-full">
          <!-- Imagen del subproducto -->
          <div class="relative h-48 overflow-hidden">
            <img src={subProducto.imagen} alt={subProducto.nombre} class="w-full h-full object-cover" loading="lazy" />
            <div class="absolute inset-0 bg-black/20"></div>
          </div>
          
          <!-- Contenido del subproducto -->
          <div class="p-6 flex flex-col flex-1">
            <h3 class="text-xl font-bold text-[#20405C] mb-3">{subProducto.nombre}</h3>
            <p class="text-gray-700 mb-4 text-sm leading-relaxed">{subProducto.descripcion}</p>
            
            <!-- Botones de acción SIEMPRE ABAJO -->
            <div class="flex flex-col sm:flex-row gap-3 mt-auto">
              <a href={`/productos/${productSlug}/${subProducto.slug}`} class="flex-1 bg-[#6B8C8C] text-white px-4 py-2 rounded font-semibold text-center hover:bg-[#355353] transition">
                VER DETALLES
              </a>
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section> 