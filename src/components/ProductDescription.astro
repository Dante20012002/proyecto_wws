---
export interface Props {
  nombre: string;
  descripcionLarga: string;
  imagen: string;
  brochureUrl: string;
  catalogoUrl?: string;
}

const { nombre, descripcionLarga, imagen, brochureUrl, catalogoUrl } = Astro.props;
---

<!-- DESCRIPCIÓN AMPLIADA Y BROCHURE: Información principal del producto, descripción y enlaces de descarga -->
<section class="w-full bg-white py-8">
  <div class="max-w-2xl md:max-w-5xl mx-auto grid grid-cols-1 md:grid-cols-3 gap-8 items-start px-4 md:px-8">
    <div class="md:col-span-2 flex flex-col justify-center">
      <h2 class="text-2xl md:text-3xl font-extrabold text-[#20405C] mb-2 uppercase tracking-tight" style="letter-spacing:0;">{nombre}</h2>
      <p class="text-black text-justify mb-4 text-base md:text-lg leading-relaxed" style="hyphens:auto;">{descripcionLarga}</p>
                  <a href={catalogoUrl || brochureUrl} target="_blank" rel="noopener" class="text-[#20405C] underline font-medium mb-2 w-fit">Descarga nuestro catálogo</a>
            <a href={catalogoUrl || brochureUrl} target="_blank" rel="noopener" class="mt-1 w-fit px-8 py-2 rounded font-bold shadow bg-[#7A8C8C] text-white text-lg hover:bg-[#5a6c6c] transition block" style="box-shadow:0 2px 6px 0 rgba(0,0,0,0.10);">BROCHURE</a>
    </div>
    <div class="flex items-center justify-center">
      <img src={imagen} alt={nombre} class="rounded-lg max-h-56 md:max-h-64 aspect-square object-cover border-4 border-[#bfc9c9] shadow-lg" style="box-shadow:0 2px 8px 0 rgba(0,0,0,0.10);" loading="lazy" />
    </div>
  </div>
</section> 