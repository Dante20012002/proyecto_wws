---
interface Props {
  links: Array<{
    text: string;
    href: string;
    isScroll?: boolean;
    needsBase?: boolean;
  }>;
}

const { links } = Astro.props;

// Obtener la ruta actual
const currentPath = Astro.url.pathname;
---

<nav class="sticky top-0 z-10 w-full bg-[#819392] text-white shadow">
  <div class="max-w-7xl mx-auto px-4 lg:px-0 h-16 lg:h-20 flex items-center relative">
    <a href="/" class="flex items-center h-full">
      <svg class="h-12 lg:h-14">
        <use href="/assets/sprite.svg#logo-splash" />
      </svg>
      <span
        class="ml-2 font-bold text-xl hidden group-hover:text-[#C9D6D7] transition-colors duration-300"
        id="logo-placeholder">WWS</span
      >
    </a>
    <ul id="desktopMenu" class="hidden lg:flex justify-start gap-8 h-full items-center ml-2">
      {
        links.map((link) => (
          <li class="relative flex flex-col items-center text-center">
            <a
              href={link.href}
              data-scroll={link.isScroll}
              data-needs-base={link.needsBase}
              data-current-path={currentPath}
              class="text-white hover:text-[#EAEAEA] font-semibold transition uppercase tracking-wide text-lg relative after:content-[''] after:absolute after:left-0 after:bottom-[-2px] after:w-full after:h-[2px] after:bg-[#EAEAEA] after:transform after:scale-x-0 after:origin-bottom-right after:transition-transform after:duration-300 hover:after:scale-x-100 hover:after:origin-bottom-left whitespace-nowrap"
            >
              {link.text}
            </a>
          </li>
        ))
      }
    </ul>
    <button id="menuButton" class="hidden lg:hidden flex items-center ml-auto p-2" aria-label="Abrir menú">
      <svg class="w-10 h-10" fill="none" stroke="currentColor" viewBox="0 0 24 24"
        ><path
          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-width="2"
          d="M4 6h16M4 12h16M4 18h16"></path></svg
      >
    </button>
  </div>
  <!-- Menú móvil -->
  <div
    id="mobileMenu"
    class="w-full bg-[#819392] shadow-md hidden lg:hidden transition-all duration-300 max-h-0 overflow-hidden"
  >
    <ul id="mobileMenuList" class="flex flex-col gap-2 py-6 px-6 transform translate-y-[-20px] opacity-0 transition-all duration-300">
      {
        links.map((link) => (
          <li class="relative">
            <a
              href={link.href}
              data-scroll={link.isScroll}
              data-needs-base={link.needsBase}
              data-current-path={currentPath}
              class="block py-4 px-4 rounded-lg text-white hover:bg-[#EAEAEA] hover:text-[#819392] font-semibold transition uppercase tracking-wide text-lg relative after:content-[''] after:absolute after:left-0 after:bottom-[-2px] after:w-full after:h-[2px] after:bg-[#819392] after:transform after:scale-x-0 after:origin-bottom-right after:transition-transform after:duration-300 hover:after:scale-x-100 hover:after:origin-bottom-left"
            >
              {link.text}
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</nav>

<script>
  // Funcionalidad del menú móvil
  const menuButton = document.getElementById('menuButton');
  const mobileMenu = document.getElementById('mobileMenu');
  const mobileMenuList = document.getElementById('mobileMenuList');
  const desktopMenu = document.getElementById('desktopMenu');
  let isMenuOpen = false;

  // Función para verificar si los enlaces caben en el espacio disponible
  const checkMenuFit = () => {
    if (!desktopMenu || !menuButton) return;

    // Obtener el contenedor principal
    const navContainer = menuButton.parentElement;
    if (!navContainer) return;

    // Solo verificar en pantallas grandes (lg y superiores)
    if (window.innerWidth < 1024) {
      desktopMenu.classList.add('hidden');
      menuButton.classList.remove('hidden');
      mobileMenu?.classList.remove('hidden');
      return;
    }

    // Calcular el espacio disponible (después del logo)
    const logo = navContainer.querySelector('a');
    const logoWidth = logo ? logo.offsetWidth + 32 : 0; // 32px de margen
    const availableWidth = navContainer.offsetWidth - logoWidth - menuButton.offsetWidth - 32; // 32px de padding total

    // Calcular el ancho total de los enlaces
    const menuItems = desktopMenu.querySelectorAll('li');
    let totalMenuWidth = 0;
    
    menuItems.forEach(item => {
      totalMenuWidth += item.offsetWidth + 32; // 32px de gap
    });

    // Si los enlaces no caben, mostrar el menú hamburguesa
    if (totalMenuWidth > availableWidth) {
      desktopMenu.classList.add('hidden');
      menuButton.classList.remove('hidden');
      mobileMenu?.classList.remove('hidden');
    } else {
      desktopMenu.classList.remove('hidden');
      menuButton.classList.add('hidden');
      mobileMenu?.classList.add('hidden');
    }
  };

  // Verificar al cargar la página
  window.addEventListener('load', () => {
    setTimeout(checkMenuFit, 100);
  });
  
  // Verificar al cambiar el tamaño de la ventana
  let resizeTimeout: ReturnType<typeof setTimeout>;
  window.addEventListener('resize', () => {
    clearTimeout(resizeTimeout);
    resizeTimeout = setTimeout(checkMenuFit, 100);
  });

  menuButton?.addEventListener('click', () => {
    isMenuOpen = !isMenuOpen;
    if (isMenuOpen) {
      // Abrir el menú
      mobileMenu?.classList.remove('max-h-0', 'overflow-hidden');
      mobileMenu?.classList.add('max-h-[500px]');
      
      // Animar los enlaces después de que el fondo se expanda
      setTimeout(() => {
        mobileMenuList?.classList.remove('translate-y-[-20px]', 'opacity-0');
        mobileMenuList?.classList.add('translate-y-0', 'opacity-100');
      }, 150); // Pequeño retraso para que el fondo se expanda primero
    } else {
      // Cerrar el menú
      mobileMenuList?.classList.add('translate-y-[-20px]', 'opacity-0');
      mobileMenuList?.classList.remove('translate-y-0', 'opacity-100');
      
      // Cerrar el fondo después de que los enlaces se animen
      setTimeout(() => {
        mobileMenu?.classList.add('max-h-0', 'overflow-hidden');
        mobileMenu?.classList.remove('max-h-[500px]');
      }, 150);
    }
  });

  // Cerrar menú al hacer clic fuera
  document.addEventListener('click', (event) => {
    if (
      isMenuOpen &&
      !mobileMenu?.contains(event.target as Node) &&
      !menuButton?.contains(event.target as Node)
    ) {
      isMenuOpen = false;
      mobileMenuList?.classList.add('translate-y-[-20px]', 'opacity-0');
      mobileMenuList?.classList.remove('translate-y-0', 'opacity-100');
      
      setTimeout(() => {
        mobileMenu?.classList.add('max-h-0', 'overflow-hidden');
        mobileMenu?.classList.remove('max-h-[500px]');
      }, 150);
    }
  });

  // Función para realizar el scroll
  const scrollToElement = (targetId: string) => {
    const targetElement = document.getElementById(targetId);
    if (!targetElement) return;

    // Obtener la altura de la navbar
    const navbar = document.querySelector('nav');
    const navbarHeight = navbar ? navbar.offsetHeight : 0;

    // Ajustes adicionales según la sección
    const offsets: Record<string, number> = {
      'mapa': 10,
      'contacto': 10
    };

    const additionalOffset = offsets[targetId] || 0;

    // Calcular la posición final
    const elementPosition = targetElement.getBoundingClientRect().top;
    const offsetPosition = elementPosition + window.scrollY - navbarHeight + additionalOffset;

    // Realizar el scroll
    window.scrollTo({
      top: offsetPosition,
      behavior: 'smooth'
    });
  };

  // Manejar el scrolling suave
  document.querySelectorAll('a[data-scroll="true"]').forEach(link => {
    link.addEventListener('click', (e) => {
      const needsBase = link.getAttribute('data-needs-base') === 'true';
      const currentPath = link.getAttribute('data-current-path');
      const href = link.getAttribute('href');
      
      // Si estamos en una página diferente a la principal y necesitamos redireccionar
      if (needsBase && currentPath && currentPath !== '/') {
        // No prevenimos el evento por defecto, dejamos que redirija
        return;
      }

      // Si estamos en la página principal o no necesitamos redireccionar
      e.preventDefault();
      const targetId = href?.split('#')[1];
      if (targetId) {
        // Cerrar el menú móvil si está abierto
        if (isMenuOpen) {
          isMenuOpen = false;
          mobileMenuList?.classList.add('translate-y-[-20px]', 'opacity-0');
          mobileMenuList?.classList.remove('translate-y-0', 'opacity-100');
          
          setTimeout(() => {
            mobileMenu?.classList.add('max-h-0', 'overflow-hidden');
            mobileMenu?.classList.remove('max-h-[500px]');
          }, 150);
        }
        
        // Realizar el scroll con un pequeño retraso
        setTimeout(() => scrollToElement(targetId), 50);
      }
    });
  });
</script>

